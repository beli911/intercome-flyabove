# Flycom éles konfiguráció.
#
# A szerveren másold `.env` néven a `deployment/` mappába (a Docker Compose
# onnan olvassa magától), és töltsd ki. A kitöltött fájl SOHA nem kerül gitbe.
#
# A lista nem találgatás és nem másolat: a szerver `assertConfigured()`-je mind
# a négyet megköveteli, és hiányukban MEGNEVEZETT okkal megtagadja az indulást
# — ez mérve van (2026-09-23), mind a négyre külön kontrollal.

# A domain, amire a Caddy tanúsítványt kér.
# ⚠️ Már a stack indítása ELŐTT mutasson a szerver IP-jére: a Let's Encrypt
# innen ellenőriz, és a sikertelen kérések heti korlátba futnak.
FLYCOM_API_DOMAIN=api.intercom.flyabove.hu

# Legalább 32 karakter — a szerver a rövidebbet is elutasítja.
# Generálás:  cd server && npm run secret
# ⚠️ Ha kiszivárog, bárki sajátot írhat alá. Rotálás után MINDEN munkamenet
# érvénytelen, tehát a stábnak újra be kell jelentkeznie — ezt forgatás közben
# ne csináld.
JWT_SECRET=

# A médiajelzés címe. Élesben KÖTELEZŐEN wss:// — a ws://-t a szerver
# elutasítja (mérve), mert titkosítatlan jelzésen a szoba-tokenek utaznának.
#
# Két út, és ez DÖNTÉS, nem beállítás:
#
#   (a) LiveKit Cloud — a TURN-relé benne van.
#       Mobilhálózaton (CGNAT) a két telefon nem lát rá egymásra, tehát relé
#       nélkül a hang nem jön át. Ma ez a legrövidebb út a terepi használathoz.
#
#   (b) Saját livekit-server — mérve a gépen lévő 1.13.6-os binárison: VAN
#       beépített TURN-je (`--turn-cert` / `--turn-key`), tehát külön coturn
#       NEM kell. Cserébe a TURN tanúsítványa és portjai (3478 / 5349) a te
#       üzemeltetésed.
LIVEKIT_URL=

# A LiveKit projekt kulcsa és titka.
# Cloudnál a projekt beállításainál; self-hostnál a livekit.yaml `keys:` alatt.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
