# Flycom API — környezeti változók.
#
# Éles környezetben ez a fájl nem a repositoryban él, hanem a szolgáltatás
# titkos tárolójában (systemd EnvironmentFile 0600 jogosultsággal, vagy a
# hosting titokkezelője). A JWT_SECRET cseréje minden munkamenetet érvénytelenít.

NODE_ENV=production
PORT=8080

# npm run secret  — legalább 32 karakter
JWT_SECRET=

# LiveKit Cloud → Settings → Keys
LIVEKIT_URL=wss://<projekt>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Az adatbázisfájl. Legyen olyan könyvtárban, amit mentés is véd.
DATABASE_PATH=/var/lib/flycom/flycom.db

# Reverse proxy mögött 1, különben a bejelentkezési limit a proxyt fojtja meg.
TRUST_PROXY=1

# Opcionális finomhangolás
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=2592000
# ROOM_TOKEN_TTL=3600
# LOGIN_ATTEMPTS=10
# LOGIN_WINDOW=900
